{
  "name": "myanimelist-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the MyAnimeList API v2, deployed on Cloudflare Workers",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "oauth": "npx tsx scripts/oauth.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@types/node": "22.10.0",
    "tsx": "4.19.2",
    "typescript": "7.0.2",
    "wrangler": "4.129.1"
  }
}
